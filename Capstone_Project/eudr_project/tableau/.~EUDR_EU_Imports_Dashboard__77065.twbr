    <dashboard enable-sort-zone-taborder='true' name='EUDR_pic'>
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='78000' id='5' is-scaled='1' param='Image/EUDR hero.png_0.jpg' type-v2='bitmap' w='98400' x='800' y='14375'>
