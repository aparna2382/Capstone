      <column caption='Last Actual Year' datatype='integer' name='[Calculation_3107493156749312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [source_dataset] : MAX(IF [volume_value_type] = &apos;ACTUAL&apos; THEN [trade_year] END) }' />
      </column>
      <column caption='Volume Actual(t)' datatype='real' name='[Calculation_3107493156876289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [volume_value_type] = &apos;ACTUAL&apos; AND [volume_t] &gt; 0 THEN [volume_t] END' />
      </column>
      <column caption='Volume Projected(t)' datatype='real' name='[Calculation_3107493157003266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3107493306691587]&#10;   AND ([volume_value_type] = &apos;PROJECTED&apos; OR [trade_year] = [Calculation_3107493156749312])&#10;   AND [volume_t] &gt; 0&#10;THEN [volume_t]&#10;END' />
      </column>
      <column caption='Projection filter' datatype='boolean' name='[Calculation_3107493307039748]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3107493306691587] OR [volume_value_type] = &apos;ACTUAL&apos;' />
      </column>
      <column caption='Last Actual Deforestation Year' datatype='integer' name='[Calculation_3107493309804550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [source_dataset] : MAX(IF [deforestation_value_type] = &apos;ACTUAL&apos; THEN [trade_year] END) }' />
      </column>
      <column caption='Ha per 1000t Actual' datatype='real' name='[Calculation_3107493309976583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [deforestation_value_type] = &apos;ACTUAL&apos; THEN [deforestation_ha_per_1000t] END' />
      </column>
      <column caption='Ha per 1000t Projected' datatype='real' name='[Calculation_3107493310234632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3107493306691587]&#10;   AND ([deforestation_value_type] = &apos;PROJECTED&apos; OR [trade_year] = [Calculation_3107493309804550])&#10;THEN [deforestation_ha_per_1000t]&#10;END' />
      </column>
      <column caption='Is latest Actual' datatype='boolean' name='[Calculation_3107493338718217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[trade_year] = [Calculation_3107493156749312] AND [volume_value_type] = &apos;ACTUAL&apos;' />
      </column>
      <column caption='KPI Volume(t)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3107493338820618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3107493338718217] THEN [volume_t] END)' />
      </column>
      <column caption='KPI Ha per 1000t' datatype='real' default-format='n0.0;-0.0' name='[Calculation_3107493339033611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3107493338718217] AND [deforestation_value_type] = &apos;ACTUAL&apos; THEN [deforestation_exposure_ha] END)&#10;/ SUM(IF [Calculation_3107493338718217] AND [deforestation_value_type] = &apos;ACTUAL&apos; THEN [volume_t] END) * 1000' />
      </column>
      <column caption='KPI Origin Known %' datatype='real' default-format='p0%' name='[Calculation_3107493339201548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3107493338718217] THEN [volume_origin_known_t] END)&#10;/ SUM(IF [Calculation_3107493338718217] THEN [volume_t] END)' />
      </column>
      <column caption='KPI Deforestation Linked %' datatype='real' default-format='p0%' name='[Calculation_3107493339369485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3107493338718217] THEN [volume_deforestation_linked_t] END)&#10;/ SUM(IF [Calculation_3107493338718217] THEN [volume_with_deforestation_data_t] END)' />
      </column>
      <column caption='KPI Latest Year' datatype='integer' default-format='n0;-0' name='[Calculation_3107493339578382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [Calculation_3107493338718217] THEN [trade_year] END)' />
