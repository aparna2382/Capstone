            <column caption='Commodities' datatype='string' name='[Calculation_3975626970529797]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([commodity]) = 1 THEN MIN([commodity])&#10;ELSEIF COUNTD([commodity]) = 2 THEN MIN([commodity]) + &apos; &amp; &apos; + MAX([commodity])&#10;ELSE STR(COUNTD([commodity])) + &apos; commodities&apos;&#10;END' />
