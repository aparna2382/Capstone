      <aliases enabled='yes' />
      <column caption='EU Destination' datatype='string' name='[Calculation_3107493346750479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [destination_country] IN (&apos;Netherlands&apos;, &apos;Spain&apos;, &apos;Italy&apos;, &apos;France&apos;,&#10;                             &apos;Germany&apos;, &apos;Belgium&apos;, &apos;Slovenia&apos;, &apos;Poland&apos;)&#10;THEN [destination_country]&#10;ELSE &apos;Other EU&apos;&#10;END' />
      </column>
      <column caption='Origin Known %' datatype='real' default-format='p0%' name='[Calculation_3107493357395984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([volume_origin_known_t]) / SUM([volume_t])' />
      </column>
      <column caption='Dataset' datatype='string' name='[Calculation_3107493361463313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[commodity] + &apos; · &apos; + [origin_country]' />
      </column>
      <column caption='Ha per 1000t' datatype='real' name='[Calculation_3107493464256536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deforestation_exposure_ha]) / SUM([volume_t]) * 1000' />
      </column>
      <column caption='Ha per $1M' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3107493498236953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deforestation_exposure_ha]) / SUM([trade_value_usd]) * 1000000' />
      </column>
      <column caption='Has deforestation data' datatype='boolean' name='[Calculation_3107493499101210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([deforestation_exposure_ha])' />
      </column>
      <column caption='Deforestation' datatype='string' name='[Calculation_3975626951348225]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(SUM([deforestation_exposure_ha]))&#10;THEN &apos;Not published&apos;&#10;ELSE STR(ROUND(SUM([deforestation_exposure_ha]), 0)) + &apos; ha&apos;&#10;END' />
      </column>
      <column caption='Origin Known' datatype='string' name='[Calculation_3975626951712770]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_3107493357395984])&#10;THEN &apos;Not published&apos;&#10;ELSE STR(ROUND([Calculation_3107493357395984] * 100, 0)) + &apos;%&apos;&#10;END' />
      </column>
      <column caption='Year Range' datatype='string' name='[Calculation_3975626952192003]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([trade_year]) = MAX([trade_year])&#10;THEN STR(MIN([trade_year]))&#10;ELSE STR(MIN([trade_year])) + &apos;–&apos; + STR(MAX([trade_year]))&#10;END' />
      </column>
      <column caption='Origins' datatype='string' name='[Calculation_3975626969649156]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([origin_country]) = 1&#10;THEN MIN([origin_country])&#10;ELSE STR(COUNTD([origin_country])) + &apos; origin countries&apos;&#10;END' />
      </column>
      <column caption='Commodities' datatype='string' name='[Calculation_3975626970529797]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([commodity]) = 1 THEN MIN([commodity])&#10;ELSEIF COUNTD([commodity]) = 2 THEN MIN([commodity]) + &apos; &amp; &apos; + MAX([commodity])&#10;ELSE STR(COUNTD([commodity])) + &apos; commodities&apos;&#10;END' />
      </column>
      <column caption='Commodity Mix' datatype='string' name='[Calculation_3975626989047814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [origin_country] :&#10;  IF COUNTD([commodity]) = 1 THEN MIN([commodity])&#10;  ELSE &apos;Multiple commodities&apos; END }' />
      </column>
