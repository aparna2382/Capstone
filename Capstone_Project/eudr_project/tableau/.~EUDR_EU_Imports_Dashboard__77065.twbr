                <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98784' x='608' y='5083' />
                <zone h='83610' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98784' x='608' y='15560'>
                  <flipboard active-id='23' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Introduction to the Project' captured-sheet='EUDR_pic' id='1'>
                        <capturedDeltas>
                          <dashboard name='EUDR_pic'>
                            <zone id='20'>
                              <formatted-text>
                                <run bold='true' fontalignment='1' fontcolor='#59a14f' fontname='Tableau Bold' fontsize='22'>European Union Deforestation Regulation(EUDR)</run>
                                <run fontalignment='1'>Æ&#10;</run>
                                <run bold='true' fontalignment='1' fontcolor='#59a14f' fontname='Tableau Bold' fontsize='22'>Readiness Analysis</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Importance of EUDR' captured-sheet='Imp of EUDR' id='4' />
                      <story-point caption='Data pipeline' captured-sheet='datapipeline' id='7' />
                      <story-point caption='Questions_Roadmap' captured-sheet='Question_roadmap' id='21' />
                      <story-point caption='EU import per volume and deforestation exposure' captured-sheet='Overview' id='5' />
                      <story-point caption='EU Import Flows' captured-sheet='Flows &amp; origins' id='12' />
                      <story-point caption='Maps_origin to deforestation exposure' captured-sheet='Maps' id='15'>
                        <capturedDeltas>
                          <worksheet name='Commodities map'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <encoding attr='space' class='0' field='[federated.1hv923v01afyzt15ys3qc0g0qicw].[Latitude (generated)]' field-type='quantitative' max='3445894.4382447517' min='-4450393.8036642428' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                                <encoding attr='space' class='0' field='[federated.1hv923v01afyzt15ys3qc0g0qicw].[Longitude (generated)]' field-type='quantitative' max='19717383.140752025' min='-16223121.510159202' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                              </style-rule>
                            </style>
                          </worksheet>
                          <worksheet name='Deforestation Map'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <encoding attr='space' class='0' field='[federated.1hv923v01afyzt15ys3qc0g0qicw].[Latitude (generated)]' field-type='quantitative' max='3763900.5930839963' min='-5474081.4825599287' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                                <encoding attr='space' class='0' field='[federated.1hv923v01afyzt15ys3qc0g0qicw].[Longitude (generated)]' field-type='quantitative' max='17545023.184306145' min='-15355157.90579287' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                              </style-rule>
                            </style>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Exposure by country and commodity' captured-sheet='Deforestation Risk by trade' id='20'>
                        <capturedDeltas>
                          <dashboard name='Deforestation Risk by trade'>
                            <zone id='13'>
                              <formatted-text>
                                <run fontcolor='#000000' fontname='Benton Sans Book'>*Cocoa: 15-year exposure window, so values are higher where shown. No cocoa deforestation data is published for 2022–2024. Coffee has no deforestation data.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Data Completeness' captured-sheet='Data_availability' id='17'>
                        <capturedDeltas>
                          <dashboard name='Data_availability'>
                            <zone id='38'>
                              <formatted-text>
                                <run fontcolor='#333333' fontsize='11'>2020 is our baseline year, before the EUDR cut-off, so it shows as complete. From 2021 we need post-2020 data, and that’s where most commodities fall short.</run>
                                <run>Æ&#10;</run>
                                <run bold='true' fontcolor='#333333' fontsize='11'>Importers of 77% of EU volume can’t yet prove “deforestation-free” from public data. They will need their own plot-level traceability.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Conclusion' captured-sheet='Conclusion' id='22' />
                      <story-point caption='Thank You' captured-sheet='Thankyou' id='23' />
                    </story-points>
                  </flipboard>
                </zone>
              </zone>
            </zone>
