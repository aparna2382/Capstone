          <datasource-dependencies datasource='federated.1hv923v01afyzt15ys3qc0g0qicw'>
            <column caption='Ha per $1M' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3107493498236953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deforestation_exposure_ha]) / SUM([trade_value_usd]) * 1000000' />
            </column>
            <column caption='Has deforestation data' datatype='boolean' name='[Calculation_3107493499101210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([deforestation_exposure_ha])' />
