    <worksheet name='Deforestation Intensity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='12'>Deforestation exposure per 1,000 t of EU imports</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='KPI Yearly' name='federated.1hymooq1k7ux6g19vezb80n9n2bh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Show Projections' caption='Show Projections' datatype='boolean' name='[Parameter 3107493306691587]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Availabel data only' />
                <alias key='true' value='Show Projections' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hymooq1k7ux6g19vezb80n9n2bh'>
            <column caption='Last Actual Deforestation Year' datatype='integer' name='[Calculation_3107493309804550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [source_dataset] : MAX(IF [deforestation_value_type] = &apos;ACTUAL&apos; THEN [trade_year] END) }' />
            </column>
            <column caption='Ha per 1000t Actual' datatype='real' name='[Calculation_3107493309976583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [deforestation_value_type] = &apos;ACTUAL&apos; THEN [deforestation_ha_per_1000t] END' />
            </column>
            <column caption='Ha per 1000t Projected' datatype='real' name='[Calculation_3107493310234632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3107493306691587]&#10;   AND ([deforestation_value_type] = &apos;PROJECTED&apos; OR [trade_year] = [Calculation_3107493309804550])&#10;THEN [deforestation_ha_per_1000t]&#10;END' />
            </column>
            <column-instance column='[deforestation_method]' derivation='Attribute' name='[attr:deforestation_method:nk]' pivot='key' type='nominal' />
            <column-instance column='[deforestation_value_type]' derivation='Attribute' name='[attr:deforestation_value_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3107493309976583]' derivation='Avg' name='[avg:Calculation_3107493309976583:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3107493310234632]' derivation='Avg' name='[avg:Calculation_3107493310234632:qk]' pivot='key' type='quantitative' />
