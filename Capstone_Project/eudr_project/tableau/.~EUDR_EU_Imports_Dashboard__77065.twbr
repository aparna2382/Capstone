      <table>
        <view>
          <datasources>
            <datasource caption='Trade Flows' name='federated.1hv923v01afyzt15ys3qc0g0qicw' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1hv923v01afyzt15ys3qc0g0qicw'>
            <column caption='Origin Known %' datatype='real' default-format='p0%' name='[Calculation_3107493357395984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([volume_origin_known_t]) / SUM([volume_t])' />
            </column>
            <column caption='Deforestation' datatype='string' name='[Calculation_3975626951348225]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([deforestation_exposure_ha]))&#10;THEN &apos;Not published&apos;&#10;ELSE STR(ROUND(SUM([deforestation_exposure_ha]), 0)) + &apos; ha&apos;&#10;END' />
            </column>
            <column caption='Origin Known' datatype='string' name='[Calculation_3975626951712770]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_3107493357395984])&#10;THEN &apos;Not published&apos;&#10;ELSE STR(ROUND([Calculation_3107493357395984] * 100, 0)) + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Year Range' datatype='string' name='[Calculation_3975626952192003]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([trade_year]) = MAX([trade_year])&#10;THEN STR(MIN([trade_year]))&#10;ELSE STR(MIN([trade_year])) + &apos;–&apos; + STR(MAX([trade_year]))&#10;END' />
            </column>
            <column-instance column='[commodity]' derivation='Attribute' name='[attr:commodity:nk]' pivot='key' type='nominal' />
